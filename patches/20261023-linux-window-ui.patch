+  })
+
+  it('keeps fresh Linux defaults opaque in either appearance', () => {
+    for (const appearance of ['light', 'dark'] as const) {
+      const state = defaultTranslucencyState(appearance, false, false)
+
+      expect(windowOpacityFor(state, 'linux')).toBe(1)
+      expect(windowOpacityOptions(state, 'linux')).toStrictEqual({})
+    }
+  })
+
+  it.each(['linux', 'freebsd'])('ignores every clear intensity or glass fade on %s', platform => {
+    for (let lever = 0; lever <= 100; lever += 1) {
+      for (const state of [
+        { ...legacyLinuxState, intensity: lever },
+        { ...legacyLinuxState, mode: 'glass' as const, intensity: 29, fade: lever }
+      ]) {
+        expect(windowOpacityFor(state, platform)).toBe(1)
+        expect(windowOpacityOptions(state, platform)).toStrictEqual({})
+      }
+    }
+  })
+
+  it('does not let stale renderer updates change native opacity on Linux', () => {
+    const previous = windowOpacityFor(legacyLinuxState, 'linux')
+    const updated = normalizeState({ mode: 'glass', intensity: 100, fade: 100 }, false)
+
+    expect(windowOpacityFor(updated, 'linux')).toBe(previous)
+    expect(legacyLinuxState).toMatchObject({ mode: 'clear', intensity: 29, fade: 0 })
+    expect(updated).toMatchObject({ mode: 'clear', intensity: 100, fade: 100 })
+  })
+})
+
+describe.each(['darwin', 'win32'])('supported-platform native opacity on %s', platform => {
+  it('preserves the existing clear intensity ramp', () => {
+    for (const intensity of [0, 1, 29, 100]) {
+      const state = { ...legacyLinuxState, intensity }
+      const expected = 1 - 0.7 * (intensity / 100) ** 2
+
+      expect(windowOpacityFor(state, platform)).toBe(expected)
+      expect(windowOpacityOptions(state, platform)).toStrictEqual(intensity === 0 ? {} : { opacity: expected })
+    }
+  })
+
+  it('keeps glass unfaded until its separate fade lever is raised', () => {
+    const state = { ...legacyLinuxState, mode: 'glass' as const }
+
+    expect(windowOpacityFor(state, platform)).toBe(1)
+    expect(windowOpacityOptions(state, platform)).toStrictEqual({})
+    expect(windowOpacityFor({ ...state, fade: 29 }, platform)).toBe(0.94113)
+    expect(windowOpacityOptions({ ...state, fade: 29 }, platform)).toStrictEqual({ opacity: 0.94113 })
+    expect(windowOpacityFor({ ...state, intensity: 0, fade: 29 }, platform)).toBe(1)
+  })
+})
diff --git a/apps/desktop/src/app/shell/hooks/use-window-controls-overlay-width.test.ts b/apps/desktop/src/app/shell/hooks/use-window-controls-overlay-width.test.ts
new file mode 100644
index 0000000000..a2fe86a0e8
--- /dev/null
+++ b/apps/desktop/src/app/shell/hooks/use-window-controls-overlay-width.test.ts
@@ -0,0 +1,78 @@
+import { act, cleanup, renderHook } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import { useWindowControlsOverlayInsets } from './use-window-controls-overlay-width'
+
+class Overlay extends EventTarget {
+  visible = true
+  rect = new DOMRect(72, 0, 928, 34)
+
+  getTitlebarAreaRect() {
+    return this.rect
+  }
+}
+
+function install(overlay: Overlay) {
+  vi.spyOn(window, 'innerWidth', 'get').mockReturnValue(1000)
+  Object.defineProperty(navigator, 'windowControlsOverlay', { configurable: true, value: overlay })
+}
+
+afterEach(() => {
+  cleanup()
+  vi.restoreAllMocks()
+  Reflect.deleteProperty(navigator, 'windowControlsOverlay')
+})
+
+describe('native titlebar reservations', () => {
+  it('reserves the left controls and keeps a measured zero on the right', () => {
+    install(new Overlay())
+
+    const { result } = renderHook(() => useWindowControlsOverlayInsets())
+
+    expect(result.current).toEqual({ left: 72, right: 0 })
+  })
+
+  it('tracks controls on either side after geometry changes and resize', () => {
+    const overlay = new Overlay()
+
+    install(overlay)
+
+    const { result, unmount } = renderHook(() => useWindowControlsOverlayInsets())
+
+    act(() => {
+      overlay.rect = new DOMRect(0, 0, 904, 34)
+      overlay.dispatchEvent(new Event('geometrychange'))
+    })
+    expect(result.current).toEqual({ left: 0, right: 96 })
+
+    act(() => {
+      overlay.rect = new DOMRect(48, 0, 880, 34)
+      window.dispatchEvent(new Event('resize'))
+    })
+    expect(result.current).toEqual({ left: 48, right: 72 })
+
+    const removeOverlay = vi.spyOn(overlay, 'removeEventListener')
+    const removeWindow = vi.spyOn(window, 'removeEventListener')
+
+    unmount()
+    expect(removeOverlay).toHaveBeenCalledWith('geometrychange', expect.any(Function))
+    expect(removeWindow).toHaveBeenCalledWith('resize', expect.any(Function))
+  })
+
+  it('keeps the fallback when the native overlay has no usable geometry', () => {
+    const overlay = new Overlay()
+
+    overlay.visible = false
+    install(overlay)
+
+    const { result } = renderHook(() => useWindowControlsOverlayInsets())
+
+    expect(result.current).toBeNull()
+    act(() => {
+      overlay.visible = true
+      overlay.rect = new DOMRect(0, 0, 0, 0)
+      overlay.dispatchEvent(new Event('geometrychange'))
+    })
+    expect(result.current).toBeNull()
+  })
+})
